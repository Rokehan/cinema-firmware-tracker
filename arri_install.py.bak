"""Extract ARRI's update procedure from their release notes PDFs.

ARRI's SUP web pages carry only the EULA and the downloads, so the update
procedure lives in the release notes PDF, near the end, under a heading like
"Update Procedure" or "Camera Update Procedure". The steps are quoted
verbatim; nothing is written or summarised.

Reads arri_cameras.json for each camera's release notes link, and writes
arri_install.json keyed by slug.

Requires pypdf. If it is missing the script says so and writes nothing.

Run:  python3 arri_install.py
"""

import io
import json
import re
import time
import urllib.request

SOURCE = "arri_cameras.json"
OUTPUT = "arri_install.json"

# ARRI's own heading for the procedure, most specific first.
START_HEADS = (
    "Camera Update Procedure",
    "Update Procedure",
    "Updating the Camera",
    "Update procedure",
)

# Where the procedure ends and unrelated material begins.
STOP_HEADS = (
    "Known Issues",
    "Downgrading",
    "Downdating",
    "Registration",
    "Legal",
    "Disclaimer",
    "Technical Data",
    "SOFTWARE LICENCE",
    "SOFTWARE LICENSE",
    "Appendix",
)

# Lines that are page furniture rather than instructions.
NOISE_RE = re.compile(
    r"^(?:page\s*\d+|\d+\s*/\s*\d+|\d{1,3}|arri|www\.arri\.com|"
    r"release notes?|software update package.*|"
    r"[A-Z]{2,}\s*\d{2,}.*)$",
    re.I,
)

FILE_RE = re.compile(r"\*?\.(swu|sup|lic)\b", re.I)


def fetch(url, tries=3):
    last = None
    for attempt in range(tries):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            return urllib.request.urlopen(req, timeout=90).read()
        except Exception as err:
            last = err
            time.sleep(3)
    raise last


def pdf_text(raw):
    import pypdf
    reader = pypdf.PdfReader(io.BytesIO(raw))
    pages = []
    for page in reader.pages:
        try:
            pages.append(page.extract_text() or "")
        except Exception:
            pages.append("")
    return chr(10).join(pages), len(reader.pages)


def tidy(lines):
    """Join wrapped lines back into whole sentences and steps."""
    steps = []
    current = ""

    for raw in lines:
        line = " ".join(raw.split())
        if not line or NOISE_RE.match(line):
            continue

        numbered = re.match(r"^(\d{1,2})[.)]\s+(.*)$", line)
        bulleted = re.match(r"^[\u2022\u00a7\u25aa\-\u2013]\s*(.*)$", line)

        if numbered:
            if current:
                steps.append(current)
            current = numbered.group(2).strip()
        elif bulleted:
            if current:
                steps.append(current)
            current = bulleted.group(1).strip()
        elif current:
            current = current + " " + line
        else:
            current = line

    if current:
        steps.append(current)

    out = []
    for step in steps:
        step = " ".join(step.split()).strip(" .;")
        if len(step) < 4 or len(step) > 460:
            continue
        if step not in out:
            out.append(step)
    return out


def procedure(text):
    """The update procedure section, as ARRI wrote it."""
    start = -1
    heading = None
    for candidate in START_HEADS:
        index = text.find(candidate)
        if index > -1:
            start = index
            heading = candidate
            break
    if start < 0:
        return None, []

    tail = text[start + len(heading):]
    cut = len(tail)
    for stop in STOP_HEADS:
        index = tail.find(stop)
        if -1 < index < cut:
            cut = index
    body = tail[:cut]

    return heading, tidy(body.split(chr(10)))


def file_hint(steps):
    """The file extension ARRI names, for the bench line."""
    for step in steps:
        hit = FILE_RE.search(step)
        if hit:
            return "*." + hit.group(1).upper()
    return None


def main():
    try:
        import pypdf  # noqa: F401
    except ImportError:
        print("pypdf is not installed. Run:  pip install pypdf")
        print("Nothing written.")
        return

    with open(SOURCE, encoding="utf-8") as fh:
        cameras = json.load(fh)

    print("ARRI cameras: " + str(len(cameras)))
    print("")

    results = []
    for row in cameras:
        slug = row.get("slug")
        pdf_url = row.get("release_notes_download")
        print("=" * 58)
        print(slug)

        if not pdf_url:
            print("  no release notes pdf listed, skipped")
            print("")
            continue

        try:
            raw = fetch(pdf_url)
        except Exception as err:
            print("  download failed: " + str(err)[:60])
            print("")
            continue

        try:
            text, pages = pdf_text(raw)
        except Exception as err:
            print("  could not read pdf: " + str(err)[:60])
            print("")
            continue

        heading, steps = procedure(text)
        if not steps:
            print("  pages " + str(pages) + ", no update procedure found")
            print("")
            continue

        results.append({
            "slug": slug,
            "install": [{"heading": heading, "items": steps}],
            "install_version": row.get("version"),
            "install_source": pdf_url,
            "file_name": file_hint(steps),
        })

        print("  pages " + str(pages) + ", section: " + str(heading))
        print("  steps: " + str(len(steps)))
        for step in steps[:3]:
            print("    - " + step[:86])
        print("")
        time.sleep(1)

    with open(OUTPUT, "w", encoding="utf-8") as fh:
        json.dump(results, fh, indent=2, ensure_ascii=False)

    print("Saved " + str(len(results)) + " of " + str(len(cameras))
          + " to " + OUTPUT)


if __name__ == "__main__":
    main()
