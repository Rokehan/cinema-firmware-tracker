name: Daily firmware check

on:
  schedule:
    - cron: "0 0 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Scrape ARRI
        run: python arri_cameras.py

      - name: Fetch ARRI details
        run: python arri_details.py

      - name: Extract ARRI install steps
        run: |
          pip install --quiet pypdf
          python arri_install.py

      - name: Scrape Sony index
        run: python sony_downloads.py

      - name: Scrape Sony FX line
        run: python sony_fx.py

      - name: Resolve Sony file URLs
        run: python sony_files.py

      - name: Scrape Sony Alpha
        run: python sony_alpha.py

      - name: Scrape RED
        run: python red_cameras.py

      - name: Build feed
        run: python build_feed.py

      - name: Detect changes
        run: python check_changes.py

      - name: Build site
        run: python build_site.py

      - name: Commit updated data
        run: |
          git config user.name "firmware-bot"
          git config user.email "bot@users.noreply.github.com"
          git add feed.json snapshot.json arri_install.json sony_alpha.json red_cameras.json arri_cameras.json arri_details.json index.html sony_cameras.json sony_fx.json
          git diff --staged --quiet || git commit -m "Daily firmware check"
          git push